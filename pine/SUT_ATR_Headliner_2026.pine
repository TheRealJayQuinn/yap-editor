//@version=6
// =============================================================================
// SUT ATR Headliner 2026  ->  Pine Script v6 port
// Original: NinjaTrader 8 indicator "SUT_ATR-Headliner_2026"
//           class NinjaTrader.NinjaScript.Indicators.StartupTrading.SUTATR2026
//           DisplayName "SUT_ATR"
//
// Source DLL was a protected/locked vendor export. The three override bodies
// (OnStateChange, OnBarUpdate, OnRender/DrawLabel) were stripped to empty stubs,
// so the exact render math is not in the binary. Everything below marked EXACT
// was recovered from surviving metadata (fields, property signatures, Range and
// Display attributes). Everything marked INFERRED is a faithful reconstruction
// of standard NinjaTrader ATR-headliner behavior; adjust if your original differs.
//
// EXACT (recovered from metadata):
//   Overlay indicator built around an ATR value.
//   Internal fields: R_ATR_S (double, the ATR value), PrTk (double, tick size),
//                    textBrush, bgBrush, labelFormat, cachedRT -> draws a chart label.
//   Inputs (group "ATR Parameters"):
//     NumberOfBars  int    Range[1, 2147483647]  "Number of Bars"  Order 0
//                          desc "ATR Number of bars used for the ATR"
//     Factor        double Range[0.1, max]       "Factor"          Order 1
//                          desc "ATR Multiplier"
//     EnableBars    bool                          "Plot Bars"       Order 2
//                          desc "ATR"
//   Defaults were in the stripped OnStateChange, so they are NOT recoverable.
//   NumberOfBars default set to 14 (NinjaTrader ATR default); Factor to 1.0.
//
// INFERRED (stripped render logic reconstructed):
//   ATR uses Wilder smoothing (NinjaTrader ATR == Pine ta.atr, both RMA based).
//   proj = ATR * Factor is drawn as a large "headliner" label on the chart.
//   EnableBars colors bars whose true range exceeds proj (a volatility flag).
// =============================================================================

indicator("SUT ATR Headliner 2026", "SUT_ATR", overlay = true)

// --- Inputs (names, group, ranges match the recovered metadata) ---------------
numberOfBars = input.int(14, "Number of Bars", minval = 1, group = "ATR Parameters", tooltip = "ATR Number of bars used for the ATR")
factor       = input.float(1.0, "Factor", minval = 0.1, step = 0.1, group = "ATR Parameters", tooltip = "ATR Multiplier")
enableBars   = input.bool(false, "Plot Bars", group = "ATR Parameters", tooltip = "Color bars whose range exceeds ATR * Factor")

// Display options for the headliner label (not in the original metadata)
labelPos   = input.string("Top Right", "Headliner position", options = ["Top Right", "Top Center", "Top Left", "Bottom Right", "Bottom Center", "Bottom Left"], group = "Display")
labelColor = input.color(color.new(color.orange, 0), "Text color", group = "Display")
bgColor    = input.color(color.new(color.black, 30), "Background", group = "Display")
upBar      = input.color(color.orange, "Highlight color", group = "Display")

// --- Calculation --------------------------------------------------------------
// R_ATR_S: Wilder ATR over NumberOfBars bars. ta.atr uses ta.rma, matching NinjaTrader.
rAtr = ta.atr(numberOfBars)
proj = rAtr * factor                 // ATR * Factor
tick = syminfo.mintick               // PrTk: tick size
atrTicks  = rAtr / tick
projTicks = proj / tick

// --- Bar coloring (EnableBars / "Plot Bars") ---------------------------------
tr        = ta.tr(true)
highlight = enableBars and tr > proj
barcolor(highlight ? upBar : na, title = "ATR Range Highlight")

// --- Headliner label ----------------------------------------------------------
posMap(p) =>
    p == "Top Right"      ? position.top_right :
     p == "Top Center"    ? position.top_center :
     p == "Top Left"      ? position.top_left :
     p == "Bottom Right"  ? position.bottom_right :
     p == "Bottom Center" ? position.bottom_center :
     position.bottom_left

var table head = table.new(posMap(labelPos), 1, 3, border_width = 1)

if barstate.islast
    table.cell(head, 0, 0, "SUT ATR", text_color = labelColor, bgcolor = bgColor, text_size = size.large)
    table.cell(head, 0, 1, str.format("ATR {0}  ({1} tk)", str.tostring(rAtr, format.mintick), str.tostring(math.round(atrTicks))), text_color = labelColor, bgcolor = bgColor, text_size = size.normal)
    table.cell(head, 0, 2, str.format("x{0} = {1}  ({2} tk)", str.tostring(factor), str.tostring(proj, format.mintick), str.tostring(math.round(projTicks))), text_color = labelColor, bgcolor = bgColor, text_size = size.normal)
