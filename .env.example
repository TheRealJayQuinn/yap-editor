# Copy to .env and fill in. .env is gitignored — never commit real values.
# Nothing in the transcribe -> cut -> render path needs any of this.
# These are only for `review/publish.py`, which uploads renders somewhere your
# phone can reach.

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: AWS S3, Cloudflare R2, Backblaze B2, MinIO...)
# ---------------------------------------------------------------------------

# Leave blank for AWS S3. For R2:    https://<accountid>.r2.cloudflarestorage.com
# For MinIO running locally:         http://127.0.0.1:9000
S3_ENDPOINT_URL=

S3_BUCKET=your-bucket-name
S3_REGION=auto

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Where the uploaded objects are publicly readable from, no trailing slash.
# This is what gets turned into the link you open on your phone.
PUBLIC_BASE_URL=

# Prefix every uploaded key with this (optional). Useful if the bucket is shared.
S3_KEY_PREFIX=reels

# ---------------------------------------------------------------------------
# Transcription (optional)
# ---------------------------------------------------------------------------
# auto | mlx | faster | openai   — see pipeline/README.md
TRANSCRIBE_BACKEND=auto
TRANSCRIBE_MODEL=large-v3-turbo

# ---------------------------------------------------------------------------
# LLM cut planning (optional)
# ---------------------------------------------------------------------------
# Used by the two Perplexity-backed scripts: `pipeline/research.py` (pre-shoot
# hooks and facts via web search) and `pipeline/plan_llm.py` (a structural
# cuts.json with the hook surgery, tangent trims, and take selection that plan.py
# leaves to a human). The mechanical transcribe -> plan -> cut path needs none of
# this. Get a key at https://www.perplexity.ai/settings/api.
#
# Both need outbound network access to api.perplexity.ai. In a sandboxed or
# policy-restricted environment that host must be on the egress allowlist, or the
# request is rejected before the key is ever sent. Pass `--dry-run` to either
# script to inspect the request offline, with no key or network.
PERPLEXITY_API_KEY=
